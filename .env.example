# ============================================================================
# SERVER ENVIRONMENT VARIABLES (Backend / Vercel Serverless)
# ============================================================================
PORT=5000
NODE_ENV=development
JWT_SECRET=your_secure_jwt_secret_key_minimum_32_characters

# DATABASE CONFIGURATION
# Set DB_DIALECT=sqlite for zero-config local relational SQLite
# Set DB_DIALECT=mysql for persistent hosted MySQL in production (e.g. PlanetScale, Aiven, Railway, AWS RDS)
DB_DIALECT=mysql
DB_HOST=your_mysql_host_or_aiven_url
DB_PORT=17079
DB_USER=your_db_username
DB_PASSWORD=your_mysql_password
DB_NAME=biodiversity_db

# MYSQL SSL CONFIGURATION (Required for cloud-hosted MySQL like Aiven)
# Set DB_SSL=true to enable SSL/TLS encryption for remote connections
DB_SSL=true
# Optional: Path to Aiven CA Certificate (e.g. ./ca.pem)
DB_SSL_CA_PATH=./ca.pem
# Optional: Raw CA Certificate string (useful for Vercel Environment Variables)
DB_SSL_CA=
# Optional: Set to false only if using self-signed certs without CA verification (defaults to true)
DB_SSL_REJECT_UNAUTHORIZED=true

# CORS CONFIGURATION
# Comma-separated list of allowed frontend origins (e.g. https://your-app.vercel.app)
CLIENT_URL=http://localhost:5173

# ============================================================================
# CLIENT ENVIRONMENT VARIABLES (Vite Frontend)
# ============================================================================
# Set in Vercel if frontend and backend are hosted on separate domains
# Leave blank or set to /api for single-deployment monorepo setup
VITE_API_BASE_URL=/api
